# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-here

# ── App ────────────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:3000   # Set to your production URL e.g. https://kartmaint.vercel.app

# ── Lockout policy ────────────────────────────────────────────────────────────
LOCKOUT_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Email (Mailtrap for dev, Gmail/SendGrid for production) ───────────────────
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your-mailtrap-user
EMAIL_PASS=your-mailtrap-pass
EMAIL_FROM=noreply@kartmaint.com
